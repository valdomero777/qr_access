# Copia este archivo como .env y rellena los valores.

# Cadena de conexión de PostgreSQL (Neon u otro proveedor).
DATABASE_URL=postgresql://usuario:password@host/base?sslmode=require

# Secreto para firmar los JWT de admin y staff. Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

PORT=3000

# Orígenes permitidos por CORS, separados por comas y sin barra final.
# Vacío = se acepta cualquiera (desarrollo). En producción, el dominio del frontend:
#   CORS_ORIGIN=https://<usuario>.github.io
CORS_ORIGIN=

# --- Envío del QR por correo (opcional) ---
# Si faltan, el panel permite descargar el QR pero no enviarlo.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
